# Server-side only. Copy to .env.local; never commit real keys.
# ORS is needed for Phase 1 place search.
ORS_API_KEY=
# Reserved for later phases; not used by Phases 0–1.
OPENWEATHER_API_KEY=
EIA_API_KEY=
# Supabase browser keys are publishable; RLS protects every trip table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback if the integration supplies an anon key instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
