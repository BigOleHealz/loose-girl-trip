# Server-side only. Copy to .env.local; never commit real keys.
# ORS powers server-side place search and authenticated driving routes.
ORS_API_KEY=
# Temperature tiles and weekly gas prices, accessed only by server routes.
OPENWEATHER_API_KEY=
EIA_API_KEY=
# Supabase browser keys are publishable; RLS protects every trip table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback if the integration supplies an anon key instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
